{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "ES6"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@dataverse-kit/components": ["./packages/components/src"],
      "@dataverse-kit/components/*": ["./packages/components/src/*"],
      "@dataverse-kit/api-client": ["./packages/api-client/src"],
      "@dataverse-kit/api-client/*": ["./packages/api-client/src/*"],
      "@khester/dynamics-utils": ["./packages/dynamics-utils/src"],
      "@khester/dynamics-utils/*": ["./packages/dynamics-utils/src/*"],
      "@khester/dynamics-cell-renderers": ["./packages/dynamics-cell-renderers/src"],
      "@khester/dynamics-cell-renderers/*": ["./packages/dynamics-cell-renderers/src/*"],
      "@dataverse-kit/grid-kit": ["./packages/grid-kit/src"],
      "@dataverse-kit/grid-kit/*": ["./packages/grid-kit/src/*"],
      "@dataverse-kit/design-tokens": ["./packages/design-tokens/src"],
      "@dataverse-kit/design-tokens/*": ["./packages/design-tokens/src/*"],
      "@dataverse-kit/agent-kit": ["./packages/agent-kit/src"],
      "@dataverse-kit/agent-kit/*": ["./packages/agent-kit/src/*"],
      "@dataverse-kit/fluent-theme": ["./packages/fluent-theme/src"],
      "@dataverse-kit/surface-kit": ["./packages/surface-kit/src"],
      "@dataverse-kit/surface-kit/*": ["./packages/surface-kit/src/*"],
      "@khester/dynamics-dialogs": ["./packages/dynamics-dialogs/src"],
      "@khester/dynamics-dialogs/*": ["./packages/dynamics-dialogs/src/*"],
      "@khester/dynamics-builders": ["./packages/dynamics-builders/src"],
      "@khester/dynamics-builders/*": ["./packages/dynamics-builders/src/*"],
      "@khester/dynamics-forms": ["./packages/dynamics-forms/src"],
      "@khester/dynamics-forms/*": ["./packages/dynamics-forms/src/*"]
    }
  },
  "include": [],
  "exclude": ["node_modules", "dist", "build", "**/*.test.*", "**/*.spec.*"],
  "references": [
    { "path": "./packages/components" },
    { "path": "./packages/reusable-components" },
    { "path": "./packages/api-client" },
    { "path": "./packages/create-app" },
    { "path": "./packages/components-custom" },
    { "path": "./packages/dynamics-utils" },
    { "path": "./packages/dynamics-cell-renderers" },
    { "path": "./packages/grid-kit" },
    { "path": "./packages/dynamics-dialogs" },
    { "path": "./packages/dynamics-builders" },
    { "path": "./packages/dynamics-forms" },
    { "path": "./packages/dynamics-dev-tools" },
    { "path": "./apps/web-resources" }
  ]
}
