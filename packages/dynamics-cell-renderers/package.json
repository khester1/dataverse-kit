{
  "name": "@khester/dynamics-cell-renderers",
  "version": "1.2.1",
  "license": "MIT",
  "description": "Cell renderer components for Dynamics 365 grids: text, currency, date, lookup, optionset, progress, and editable variants",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "clean": "rimraf dist coverage",
    "clean:dist": "rimraf dist"
  },
  "dependencies": {
    "@khester/dynamics-utils": "^1.2.1"
  },
  "peerDependencies": {
    "@fluentui/react": "^8.115.6",
    "react": ">=16.14.0 <19",
    "react-dom": ">=16.14.0 <19"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "rimraf": "^5.0.5",
    "rollup": "^4.6.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
