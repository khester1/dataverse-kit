{
  "name": "@dataverse-kit/agent-kit",
  "version": "0.3.3",
  "license": "MIT",
  "description": "Fluent UI v9 conversational and agent surfaces for Dynamics 365 — message thread, composer, streaming, citations, approval cards and a Teams-like app shell, styled as Dynamics CE. Ships one presentational IAgentService seam plus a MockAgentService; real transports (Foundry, Copilot Studio, broker) stay in the consuming app. The pure-TS ./core and ./services subpaths are framework-agnostic.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.cjs"
    },
    "./services": {
      "types": "./dist/services.d.ts",
      "import": "./dist/services.mjs",
      "require": "./dist/services.cjs"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.mjs",
      "require": "./dist/host.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "prebuild": "cd ../design-tokens && npm run build && cd ../fluent-theme && npm run build && cd ../surface-kit && npm run build",
    "build": "tsup",
    "dev": "tsup --watch",
    "postbuild": "node scripts/assert-no-react.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:stories": "tsc -p tsconfig.stories.json",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "storybook": "storybook dev -p 6011",
    "build-storybook": "storybook build",
    "clean": "rimraf dist coverage tsconfig.tsbuildinfo storybook-static"
  },
  "dependencies": {
    "@dataverse-kit/design-tokens": "^0.4.0",
    "@dataverse-kit/fluent-theme": "^0.3.2",
    "@dataverse-kit/surface-kit": "^0.5.2"
  },
  "peerDependencies": {
    "@fluentui/react-components": "^9.46.2",
    "@fluentui/react-icons": "^2.0.239",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@fluentui/react-components": "^9.46.2",
    "@fluentui/react-icons": "^2.0.239",
    "@storybook/addon-docs": "^10.4.4",
    "@storybook/react-vite": "^10.4.4",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.10.3",
    "jsdom": "^25.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^5.0.5",
    "storybook": "^10.4.4",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3",
    "vite": "^7.3.5",
    "vitest": "^1.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
