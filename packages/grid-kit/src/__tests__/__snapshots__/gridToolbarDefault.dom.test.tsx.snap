// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`GridToolbar (v8) default layout > renders commands left + search right, ungated when selectedCount is unset 1`] = `"<div class="ms-Stack css#"><div class="ms-StackItem css#"><div><div style="position: relative;"><div style="" data-automation-id="visibleContent"><div class="ms-FocusZone css# ms-CommandBar root#" role="menubar" data-tabster="{&quot;uncontrolled&quot;: {}}" data-focuszone-id="FocusZone#"><div role="none" class="ms-OverflowSet ms-CommandBar-primaryCommand primarySet#"><div class="ms-OverflowSet-item item#" role="none"><button type="button" role="menuitem" class="ms-Button ms-Button--commandBar ms-CommandBarItem-link root#" data-is-focusable="true" tabindex="0"><span class="ms-Button-flexContainer flexContainer#" data-automationid="splitbuttonprimary"><i data-icon-name="Add" aria-hidden="true" class="ms-Icon root# ms-Button-icon icon#"></i><span class="ms-Button-textContainer textContainer#"><span class="ms-Button-label label#" id="id__#">New</span></span></span></button></div><div class="ms-OverflowSet-item item#" role="none"><button type="button" role="menuitem" class="ms-Button ms-Button--commandBar ms-CommandBarItem-link root#" data-is-focusable="true" tabindex="-1"><span class="ms-Button-flexContainer flexContainer#" data-automationid="splitbuttonprimary"><i data-icon-name="Delete" aria-hidden="true" class="ms-Icon root# ms-Button-icon icon#"></i><span class="ms-Button-textContainer textContainer#"><span class="ms-Button-label label#" id="id__#">Delete</span></span></span></button></div></div></div></div></div></div></div><div class="ms-SearchBox root#"><div class="ms-SearchBox-iconContainer iconContainer#" aria-hidden="true"><i data-icon-name="Search" aria-hidden="true" class="ms-SearchBox-icon icon#"></i></div><input id="SearchBox#" class="ms-SearchBox-field field#" placeholder="Search rows" role="searchbox" value=""></div></div>"`;

exports[`GridToolbar (v8) default layout > renders commands left + search right, ungated when selectedCount is unset 2`] = `
[
  ".actionButton_#c#a .ms-Button-icon {font-size: 16px; width: 25px;}",
  ".actionButton_#c#a .ms-Button-label {margin: 0 4px 0 9px;}",
  ".actionButton_ade#af .ms-Button-icon {font-size: 16px; width: 25px;}",
  ".actionButton_ade#af .ms-Button-label {margin: 0 4px 0 9px;}",
  ".clearButton# .ms-Button {border-radius: 0 1px 1px 0;}",
  ".clearButton# .ms-Button-icon {color: #605e#c;}",
  ".clearButton#:hover .ms-Button {background-color: #f#f#f#;}",
  ".clearButton#:hover .ms-Button-icon {color: #323130;}",
  ".css# > * {text-overflow: ellipsis;}",
  ".css# > *:not(:first-child) {margin-left: 8px;}",
  ".css# {display: flex; flex-direction: row; flex-wrap: nowrap; width: auto; height: auto; box-sizing: border-box; justify-content: space-between; align-items: center; padding-bottom: 4px;}",
  ".css# {font-family: 'Segoe UI', 'Segoe UI Web (West European)', 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Roboto', 'Helvetica Neue', sans-serif; -moz-osx-font-smoothing: grayscale; -webkit-font-smoothing: antialiased; font-size: 14px; font-weight: 400; flex-basis: auto; height: auto; width: auto; flex-grow: 1; flex-shrink: 1;}",
  ".css#:focus {outline: none;}",
  ".field# {box-shadow: none; margin-top: 0px; margin-right: 0px; margin-bottom: 0px; margin-left: 0px; padding-top: 0px; padding-right: 0px; padding-bottom: 0.5px; padding-left: 0px; box-sizing: border-box; background-color: transparent; border: none; outline: none; font-weight: inherit; font-family: inherit; font-size: inherit; color: #323130; flex: 1 1 0px; min-width: 0px; overflow: hidden; text-overflow: ellipsis;}",
  ".field#:-ms-input-placeholder {color: #605e#c; opacity: 1;}",
  ".field#::-ms-clear {display: none;}",
  ".field#::-ms-input-placeholder {color: #605e#c; opacity: 1;}",
  ".field#::placeholder {color: #605e#c; opacity: 1;}",
  ".flexContainer# {display: flex; height: 100%; flex-wrap: nowrap; justify-content: center; align-items: center;}",
  ".icon# {display: inline-block; text-decoration: inherit; opacity: 1; transition: opacity 0.167s 0s;}",
  ".icon# {font-size: 16px; margin-top: 0; margin-right: 4px; margin-bottom: 0; margin-left: 4px; height: 16px; line-height: 16px; text-align: center; flex-shrink: 0; color: #0078d#;}",
  ".iconContainer# {display: flex; flex-direction: column; justify-content: center; flex-shrink: 0; font-size: 16px; width: 32px; text-align: center; color: #0078d#; cursor: text; transition: width 0.167s;}",
  ".item# {flex-shrink: 0; display: inherit;}",
  ".label# {margin-top: 0; margin-right: 4px; margin-bottom: 0; margin-left: 4px; line-height: 100%; display: block; font-weight: normal; white-space: nowrap;}",
  ".ms-Fabric--isFocusVisible .root#:focus:after {content: ""; position: absolute; left: 3px; top: 3px; bottom: 3px; right: 3px; border: 1px solid transparent; outline: 1px solid #605e#c; z-index: 1;}",
  ".personaContainer_#fd#a .actionButton_#fd#a .ms-Button-icon {color: #005a#e;}",
  ".personaContainer_#fd#a.personaContainerIsSelected_#fd#a .actionButton_#fd#a .ms-Button-icon {color: #005a#e;}",
  ".personaContainer_#fd#a.personaContainerIsSelected_#fd#a .actionButton_#fd#a .ms-Button-icon:hover {background: #005a#e;}",
  ".primarySet# {position: relative; display: flex; flex-wrap: nowrap; flex-grow: 1; align-items: stretch;}",
  ".root# {display: inline-block; text-decoration: inherit;}",
  ".root# {font-family: 'Segoe UI', 'Segoe UI Web (West European)', 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Roboto', 'Helvetica Neue', sans-serif; -moz-osx-font-smoothing: grayscale; -webkit-font-smoothing: antialiased; font-size: 14px; font-weight: 400; box-shadow: none; margin-top: 0px; margin-right: 0px; margin-bottom: 0px; margin-left: 0px; padding-top: 1px; padding-right: 0; padding-bottom: 1px; padding-left: 4px; box-sizing: border-box; color: #323130; background-color: #ffffff; display: flex; flex-direction: row; flex-wrap: nowrap; align-items: stretch; border-radius: 2px; border: 1px solid #605e#c; height: 32px; width: 240px;}",
  ".root# {font-family: 'Segoe UI', 'Segoe UI Web (West European)', 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Roboto', 'Helvetica Neue', sans-serif; -moz-osx-font-smoothing: grayscale; -webkit-font-smoothing: antialiased; font-size: 14px; font-weight: 400; display: flex; background-color: #ffffff; padding-top: 0px; padding-right: 0px; padding-bottom: 0px; padding-left: 0px; height: 36px;}",
  ".root# {outline: transparent; position: relative; font-family: 'Segoe UI', 'Segoe UI Web (West European)', 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Roboto', 'Helvetica Neue', sans-serif; -moz-osx-font-smoothing: grayscale; -webkit-font-smoothing: antialiased; font-size: 14px; font-weight: 400; border: none; border-radius: 0px; box-sizing: border-box; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; padding-top: 0; padding-right: 4px; padding-bottom: 0; padding-left: 4px; text-decoration: none; text-align: center; user-select: none; min-width: 40px; background-color: #ffffff; color: #323130; height: 100%;}",
  ".root#::-moz-focus-inner {border: 0;}",
  ".root#:active .ms-Button-icon {color: #005a#e;}",
  ".root#:active .ms-Button-menuIcon {color: #323130;}",
  ".root#:active > span {position: relative; left: 0px; top: 0px;}",
  ".root#:active {background-color: #edebe#; color: #201f#e;}",
  ".root#:hover .ms-Button-icon {color: #106ebe;}",
  ".root#:hover .ms-Button-menuIcon {color: #323130;}",
  ".root#:hover .ms-SearchBox-iconContainer {color: #005a#e;}",
  ".root#:hover {background-color: #f#f#f#; color: #201f#e;}",
  ".root#:hover {border-color: #323130;}",
  ".textContainer# {flex-grow: 1; display: block;}",
  ":host(.ms-Fabric--isFocusVisible) .root#:focus:after {content: ""; position: absolute; left: 3px; top: 3px; bottom: 3px; right: 3px; border: 1px solid transparent; outline: 1px solid #605e#c; z-index: 1;}",
  "html[dir=rtl] .actionButton_#c#a .ms-Button-label {margin: 0 9px 0 4px;}",
  "html[dir=rtl] .actionButton_ade#af .ms-Button-label {margin: 0 9px 0 4px;}",
]
`;
